
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<TitledPane animated="false"
            maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="500.0"
            prefWidth="750.0"
            text="Historial de ventas"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.HistorialVentasController">

    <content>
        <AnchorPane prefHeight="460.0" prefWidth="740.0">

            <children>

                <Label layoutX="25.0"
                       layoutY="20.0"
                       text="Historial de ventas">
                    <font>
                        <Font name="System Bold" size="22.0"/>
                    </font>
                </Label>

                <TableView fx:id="tablaVentas"
                           layoutX="25.0"
                           layoutY="70.0"
                           prefHeight="300.0"
                           prefWidth="690.0">

                    <columns>

                        <TableColumn fx:id="colCodigo"
                                     prefWidth="85.0"
                                     text="Código"/>

                        <TableColumn fx:id="colNombre"
                                     prefWidth="180.0"
                                     text="Producto"/>

                        <TableColumn fx:id="colCantidad"
                                     prefWidth="110.0"
                                     text="Cantidad"/>

                        <TableColumn fx:id="colPrecio"
                                     prefWidth="140.0"
                                     text="Precio unitario"/>

                        <TableColumn fx:id="colTotal"
                                     prefWidth="170.0"
                                     text="Total venta"/>

                    </columns>
                </TableView>

                <Label fx:id="lblTotalVentas"
                       layoutX="25.0"
                       layoutY="390.0"
                       text="Total generado: RD$ 0.00">
                    <font>
                        <Font name="System Bold" size="17.0"/>
                    </font>
                </Label>

                <Button layoutX="590.0"
                        layoutY="390.0"
                        mnemonicParsing="false"
                        onAction="#volverMenu"
                        prefHeight="35.0"
                        prefWidth="125.0"
                        text="Volver al menú"/>

            </children>
        </AnchorPane>
    </content>
</TitledPane>
